# ==============================================================================
# AgroVision AI 2.0 - Environment Configuration Template
# ==============================================================================
# NOTE: DO NOT commit actual secrets or production keys into version control.
# Copy this file to `.env` in the backend directory and supply appropriate values.

# ------------------------------------------------------------------------------
# 1. Application Runtime & Environment
# ------------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://agrovision.example.com

# ------------------------------------------------------------------------------
# 2. Database Connectivity
# ------------------------------------------------------------------------------
# MongoDB connection URI (e.g. Atlas cluster or local standalone instance)
# Format: mongodb+srv://<username>:<password>@<cluster-host>/<database>?appName=AgroVisionAI
MONGO_URI=mongodb+srv://<DB_USERNAME>:<DB_PASSWORD>@<DB_CLUSTER_HOST>/agrovision?appName=AgroVisionAI

# ------------------------------------------------------------------------------
# 3. Security & Authentication
# ------------------------------------------------------------------------------
# High-entropy random secret key for HMAC-SHA256 JWT generation (min 32 characters)
JWT_SECRET=replace_with_a_secure_random_secret_token_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 4. External APIs & AI Services
# ------------------------------------------------------------------------------
# Google Gemini API key for conversational farmer assistant
GEMINI_API_KEY=your_google_gemini_api_key_here

# OpenWeatherMap API key (optional for live mandi & localized weather)
WEATHER_API_KEY=your_openweathermap_api_key_here

# Agmarknet / e-NAM API key (optional for live commodity market rates)
AGMARKNET_API_KEY=your_agmarknet_api_key_here

# ------------------------------------------------------------------------------
# 5. ML Models & Inference Parameters
# ------------------------------------------------------------------------------
# Explicit relative paths to model checkpoints
MODEL_PATH_DISEASE=ml_models/disease_detection/disease_model.h5
MODEL_PATH_CANDIDATE_72CLASS=ml_models/disease_detection/unified_experiment/artifacts/agrovision_phase7_20261010_231412/AGROVISION_UNIFIED_72CLASS_MODEL.h5
MODEL_PATH_YIELD=ml_models/yield_prediction/yield_model.pkl

# Calibrated Rejection Threshold tau (Phase 9 empirical validation: 0.50)
CONFIDENCE_THRESHOLD_TAU=0.50
ABSTENTION_POLICY=balanced
MAX_UPLOAD_SIZE_BYTES=15728640
